generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                   String                 @id @default(uuid())
  name                 String
  slug                 String                 @unique
  image                String?
  domain               String?
  email                String?
  is_active            Boolean                @default(true)
  status               TenantStatus           @default(ACTIVE)
  address_line1        String?
  address_line2        String?
  city                 String?
  state                String?
  country              String?
  postal_code          String?
  latitude             Float?
  longitude            Float?
  created_by           String?
  created_at           DateTime               @default(now())
  updated_by           String?
  updated_at           DateTime?
  deleted_by           String?
  deleted_at           DateTime?
  is_deleted           Boolean                @default(false)
  diocese_id           String?
  no_graves            Int?
  phone                String?
  notifications        Notification[]
  Asset                Asset[]
  Booking              Booking[]
  Broadcast            Broadcast[]
  Category             Category[]
  Classification       Classification[]
  contributions        Contribution[]
  Divorce              Divorce[]
  EventType            EventType[]
  FamilyIncoming       FamilyIncoming[]
  FamilOutgoing        FamilOutgoing[]
  FamilTransfer        FamilTransfer[]
  family               Family[]
  Grave                Grave[]
  Location             Location[]
  member               Member[]
  Minister             Minister[]
  PrayerGroup          PrayerGroup[]
  Relation             Relation[]
  requests             Request[]
  roles                Role[]
  SacramentSubmission  SacramentSubmission[]
  sacraments           Sacrament[]
  TenantAllotmentGrave TenantAllotmentGrave[]
  tenantAttribute      TenantAttribute[]
  diocese              Diocese?               @relation(fields: [diocese_id], references: [id])
  Transaction          Transaction[]
  users                User[]
  Venue                Venue[]
  Ward                 Ward[]

  @@map("tenants")
}

model User {
  id                  String                @id @default(uuid())
  first_name          String
  last_name           String
  email               String                @unique
  phone               String?
  password_hash       String
  mfa_enable          Boolean               @default(false)
  is_active           Boolean               @default(true)
  tenant_id           String?
  created_by          String?
  created_at          DateTime              @default(now())
  updated_by          String?
  updated_at          DateTime?
  deleted_by          String?
  deleted_at          DateTime?
  is_deleted          Boolean               @default(false)
  lastLoginAt         DateTime?
  notifications       Notification[]
  QueueApproved       ApprovalQueue[]       @relation("Approved")
  QueueRejected       ApprovalQueue[]       @relation("Rejected")
  auditLogs           AuditLog[]
  DivorceHistory      DivorceHistory[]
  otps                OTP[]
  passwordToken       PasswordResetToken[]
  SacramentHistory    SacramentHistory[]
  SacramentSubmission SacramentSubmission[]
  sacraments          Sacrament[]
  sessions            Session[]
  UserRoleAttribute   UserRoleAttribute[]
  roles               UserRole[]
  tenant              Tenant?               @relation(fields: [tenant_id], references: [id])

  @@map("users")
}

model UserRole {
  id      String @id @default(uuid())
  user_id String
  role_id String
  role    Role   @relation(fields: [role_id], references: [id])
  user    User   @relation(fields: [user_id], references: [id])

  @@unique([user_id, role_id])
  @@map("user_roles")
}

model Role {
  id                String              @id @default(uuid())
  name              String              @unique
  description       String?
  permissions       Json?
  created_by        String?
  created_at        DateTime            @default(now())
  updated_by        String?
  updated_at        DateTime?
  deleted_by        String?
  deleted_at        DateTime?
  is_deleted        Boolean             @default(false)
  tenant_id         String?
  attributes        RoleAttribute[]
  tenant            Tenant?             @relation(fields: [tenant_id], references: [id])
  UserRoleAttribute UserRoleAttribute[]
  users             UserRole[]

  @@map("roles")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  user_id   String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [user_id], references: [id])

  @@map("password_reset_tokens")
}

model Family {
  id                    String                  @id @default(uuid())
  name                  String
  created_at            DateTime                @default(now())
  address_line1         String?
  address_line2         String?
  city                  String?
  classification_id     String?
  country               String?
  created_by            String?
  deleted_at            DateTime?
  deleted_by            String?
  district              String?
  head_name             String
  is_active             Boolean                 @default(true)
  is_deleted            Boolean                 @default(false)
  latitude              Float?
  longitude             Float?
  phone                 String?
  postal_code           String?
  prayer_group_id       String?
  serial_no             String
  state                 String?
  status                String?
  taluk                 String?
  updated_at            DateTime?
  updated_by            String?
  village               String?
  ward_id               String?
  tenant_id             String?
  dob                   DateTime?
  gender                Gender?
  family_image          String?
  house_image           String?
  house_name            String?
  parish_family_id      String?
  type                  FamilyType?
  comment               String?
  subscription          Int?
  is_bulk_uploaded      Boolean                 @default(true)
  Booking               Booking[]
  contributions         Contribution[]
  Divorce               Divorce[]
  FamilyAllotmentGrave  FamilyAllotmentGrave[]
  editRequests          FamilyEditRequest[]
  incoming              FamilyIncoming?
  outgoing              FamilOutgoing[]
  transfer              FamilTransfer[]
  classification        Classification?         @relation(fields: [classification_id], references: [id])
  prayerGroup           PrayerGroup?            @relation(fields: [prayer_group_id], references: [id])
  tenant                Tenant?                 @relation(fields: [tenant_id], references: [id])
  ward                  Ward?                   @relation(fields: [ward_id], references: [id])
  Grave                 Grave[]
  marriages             Marriage[]
  members               Member[]
  requests              Request[]
  SacramentBaptism      SacramentBaptism[]
  SacramentCommunion    SacramentCommunion[]
  SacramentConfirmation SacramentConfirmation[]
  SacramentDeath        SacramentDeath[]
  brideMarriages        SacramentMarriage[]     @relation("BrideFamily")
  groomMarriages        SacramentMarriage[]     @relation("GroomFamily")
  SacramentSubmission   SacramentSubmission[]
  Transaction           Transaction[]

  @@map("familys")
}

model Member {
  id                      String                  @id @default(uuid())
  gender                  Gender
  dob                     DateTime?
  status                  String?
  created_at              DateTime                @default(now())
  family_id               String
  created_by              String?
  deleted_at              DateTime?
  deleted_by              String?
  is_active               Boolean                 @default(true)
  is_deleted              Boolean                 @default(false)
  name                    String?
  updated_at              DateTime?
  updated_by              String?
  tenant_id               String?
  is_deceased             Boolean                 @default(false)
  available_home          String?
  blood_group             String?
  christening_name        String?
  display_register        String?
  education_qualification String?
  is_migration            Boolean                 @default(false)
  nri                     String?
  phone                   String?
  profession              String?
  relation_id             String?
  father_id               String?
  mother_id               String?
  prayer_group_id         String?
  ward_id                 String?
  type                    String?
  parish_name             String?
  ward_name               String?
  prayer_group_name       String?
  father_name             String?
  mother_name             String?
  spouse_name             String?
  husband_id              String?
  email                   String?
  is_divorced             Boolean                 @default(false)
  death_date              DateTime?
  marriage_date           DateTime?
  notifications           Notification[]
  Booking                 Booking[]
  contributions           Contribution[]
  custodyAssigned         Custody[]               @relation("CustodyAssigned")
  custodyRecords          Custody[]
  FamilOutgoing           FamilOutgoing[]
  GraveSlot               GraveSlot[]
  Grave                   Grave[]
  marriagesAsHusband      Marriage[]              @relation("Husband")
  marriagesAsWife         Marriage[]              @relation("Wife")
  MemberSacrament         MemberSacrament[]
  family                  Family                  @relation(fields: [family_id], references: [id])
  father                  Member?                 @relation("FatherRelation", fields: [father_id], references: [id])
  childrenFromFather      Member[]                @relation("FatherRelation")
  husband                 Member?                 @relation("HusbandRelation", fields: [husband_id], references: [id])
  wives                   Member[]                @relation("HusbandRelation")
  mother                  Member?                 @relation("MotherRelation", fields: [mother_id], references: [id])
  childrenFromMother      Member[]                @relation("MotherRelation")
  prayerGroup             PrayerGroup?            @relation(fields: [prayer_group_id], references: [id])
  relation                Relation?               @relation(fields: [relation_id], references: [id])
  tenant                  Tenant?                 @relation(fields: [tenant_id], references: [id])
  ward                    Ward?                   @relation(fields: [ward_id], references: [id])
  requests                Request[]
  SacramentBaptism        SacramentBaptism[]
  SacramentCommunion      SacramentCommunion[]
  SacramentConfirmation   SacramentConfirmation[]
  SacramentDeath          SacramentDeath[]
  brideMarriages          SacramentMarriage[]     @relation("BrideMember")
  groomMarriages          SacramentMarriage[]     @relation("GroomMember")
  Transaction             Transaction[]
  MemberOTP               MemberOTP[]

  @@map("members")
}

model OTP {
  id         String     @id @default(uuid())
  code       String
  purpose    OTPPurpose
  expires_at DateTime
  verified   Boolean    @default(false)
  user_id    String
  user       User       @relation(fields: [user_id], references: [id])

  @@map("otp")
}

model Request {
  id          String        @id @default(uuid())
  tenant_id   String
  member_id   String
  family_id   String
  type        RequestType
  status      RequestStatus @default(PENDING)
  payload     Json
  notes       String?
  created_at  DateTime      @default(now())
  updated_at  DateTime?
  reviewed_at DateTime?
  reviewed_by String?
  family      Family        @relation(fields: [family_id], references: [id])
  member      Member        @relation(fields: [member_id], references: [id])
  tenant      Tenant        @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([member_id])
  @@map("requests")
}

model Contribution {
  id             String              @id @default(uuid())
  tenant_id      String
  member_id      String
  family_id      String
  receipt_no     String?             @unique
  type           ContributionType
  amount         Decimal             @db.Decimal(10, 2)
  purpose        String
  payment_method PaymentMethod
  privacy        ContributionPrivacy
  status         ContributionStatus  @default(PENDING)
  notes          String?
  verified_at    DateTime?
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt
  family         Family              @relation(fields: [family_id], references: [id])
  member         Member              @relation(fields: [member_id], references: [id])
  tenant         Tenant              @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([member_id])
  @@index([family_id])
  @@index([status])
  @@map("contributions")
}

model Notification {
  id         String           @id @default(uuid())
  tenant_id  String
  user_id    String?
  member_id  String?
  title      String
  message    String
  type       NotificationType
  is_read    Boolean          @default(false)
  metadata   Json?
  created_at DateTime         @default(now())
  member     Member?          @relation(fields: [member_id], references: [id])
  tenant     Tenant           @relation(fields: [tenant_id], references: [id])
  user       User?            @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([user_id])
  @@index([member_id])
}

model Diocese {
  id          String    @id @default(uuid())
  name        String
  description String?
  is_active   Boolean   @default(true)
  created_by  String?
  created_at  DateTime  @default(now())
  status      String?
  updated_by  String?
  updated_at  DateTime?
  deleted_by  String?
  deleted_at  DateTime?
  is_deleted  Boolean   @default(false)
  tenants     Tenant[]

  @@map("diocese")
}

model Ward {
  id                    String                  @id @default(uuid())
  name                  String
  tenant_id             String?
  icon                  String?
  description           String?
  is_active             Boolean                 @default(true)
  created_by            String?
  created_at            DateTime                @default(now())
  status                String?
  updated_by            String?
  updated_at            DateTime?
  deleted_by            String?
  deleted_at            DateTime?
  is_deleted            Boolean                 @default(false)
  Booking               Booking[]
  Broadcast             Broadcast[]
  Divorce               Divorce[]
  family                Family[]
  Grave                 Grave[]
  MemberSacrament       MemberSacrament[]
  Member                Member[]
  prayerGroup           PrayerGroup[]
  SacramentBaptism      SacramentBaptism[]
  SacramentCommunion    SacramentCommunion[]
  SacramentConfirmation SacramentConfirmation[]
  SacramentDeath        SacramentDeath[]
  brideMarriages        SacramentMarriage[]     @relation("BrideWard")
  groomMarriages        SacramentMarriage[]     @relation("GroomWard")
  Transaction           Transaction[]
  tenant                Tenant?                 @relation(fields: [tenant_id], references: [id])

  @@map("wards")
}

model PrayerGroup {
  id                    String                  @id @default(uuid())
  name                  String
  tenant_id             String?
  icon                  String?
  description           String?
  is_active             Boolean                 @default(true)
  created_by            String?
  created_at            DateTime                @default(now())
  status                String?
  updated_by            String?
  updated_at            DateTime?
  deleted_by            String?
  deleted_at            DateTime?
  is_deleted            Boolean                 @default(false)
  ward_id               String?
  Booking               Booking[]
  Divorce               Divorce[]
  family                Family[]
  Grave                 Grave[]
  Member                Member[]
  tenant                Tenant?                 @relation(fields: [tenant_id], references: [id])
  ward                  Ward?                   @relation(fields: [ward_id], references: [id])
  SacramentBaptism      SacramentBaptism[]
  SacramentCommunion    SacramentCommunion[]
  SacramentConfirmation SacramentConfirmation[]
  SacramentDeath        SacramentDeath[]
  brideMarriages        SacramentMarriage[]     @relation("BridePrayerGroup")
  groomMarriages        SacramentMarriage[]     @relation("GroomPrayerGroup")
  Transaction           Transaction[]

  @@map("prayer_groups")
}

model Classification {
  id          String    @id @default(uuid())
  name        String
  tenant_id   String?
  icon        String?
  description String?
  is_active   Boolean   @default(true)
  created_by  String?
  created_at  DateTime  @default(now())
  status      String?
  updated_by  String?
  updated_at  DateTime?
  deleted_by  String?
  deleted_at  DateTime?
  is_deleted  Boolean   @default(false)
  tenant      Tenant?   @relation(fields: [tenant_id], references: [id])
  family      Family[]

  @@map("classifications")
}

model Relation {
  id          String    @id @default(uuid())
  name        String
  tenant_id   String?
  icon        String?
  description String?
  is_active   Boolean   @default(true)
  created_by  String?
  created_at  DateTime  @default(now())
  status      String?
  updated_by  String?
  updated_at  DateTime?
  deleted_by  String?
  deleted_at  DateTime?
  is_deleted  Boolean   @default(false)
  order       Int       @default(0)
  Member      Member[]
  tenant      Tenant?   @relation(fields: [tenant_id], references: [id])

  @@map("relation")
}

model Broadcast {
  id              String                @id @default(uuid())
  tenant_id       String?
  type            BroadcastType         @default(SMS)
  title           String?
  date            DateTime?
  time            String?
  ward_id         String?
  scheduled_at    DateTime?
  sent_at         DateTime?
  failed_reason   String?
  delivery_at     DateTime?
  target_audience String?
  content         String?
  is_immediately  Boolean               @default(false)
  status          BroadcastStatus       @default(PUBLISHED)
  created_by      String?
  created_at      DateTime              @default(now())
  updated_by      String?
  updated_at      DateTime?
  deleted_by      String?
  deleted_at      DateTime?
  is_deleted      Boolean               @default(false)
  is_delivery     Boolean               @default(false)
  category        AnnouncementCategory?
  is_important    Boolean               @default(false)
  tenant          Tenant?               @relation(fields: [tenant_id], references: [id])
  ward            Ward?                 @relation(fields: [ward_id], references: [id])

  @@map("broadcasts")
}

model Attribute {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  is_active          Boolean             @default(true)
  created_by         String?
  created_at         DateTime            @default(now())
  updated_by         String?
  updated_at         DateTime?
  deleted_by         String?
  deleted_at         DateTime?
  is_deleted         Boolean             @default(false)
  status             String?
  icon               String?
  sub_name           String?
  slug               String?
  roles              RoleAttribute[]
  subAttribute       SubAttribute[]
  TenantAttribute    TenantAttribute[]
  userRoleAttributes UserRoleAttribute[]

  @@map("attributes")
}

model SubAttribute {
  id           String           @id @default(uuid())
  name         String
  description  String?
  permissions  PermissionType[] @default([])
  is_active    Boolean          @default(true)
  created_by   String?
  created_at   DateTime         @default(now())
  status       String?
  updated_by   String?
  updated_at   DateTime?
  deleted_by   String?
  deleted_at   DateTime?
  is_deleted   Boolean          @default(false)
  attribute_id String
  sub_name     String?
  slug         String?
  attribute    Attribute        @relation(fields: [attribute_id], references: [id])

  @@map("sub_attribute")
}

model RoleAttribute {
  id           String    @id @default(uuid())
  role_id      String
  attribute_id String
  attribute    Attribute @relation(fields: [attribute_id], references: [id])
  role         Role      @relation(fields: [role_id], references: [id])

  @@map("role_attributes")
}

model UserRoleAttribute {
  id           String           @id @default(uuid())
  role_id      String
  user_id      String
  attribute_id String
  permissions  PermissionType[]
  is_active    Boolean          @default(true)
  status       String?
  attribute    Attribute        @relation(fields: [attribute_id], references: [id])
  role         Role             @relation(fields: [role_id], references: [id])
  user         User             @relation(fields: [user_id], references: [id])

  @@map("user_role_attributes")
}

model TenantAttribute {
  id           String           @id @default(uuid())
  tenant_id    String
  attribute_id String
  permissions  PermissionType[]
  is_active    Boolean          @default(true)
  status       String?
  attribute    Attribute        @relation(fields: [attribute_id], references: [id])
  tenant       Tenant           @relation(fields: [tenant_id], references: [id])

  @@map("tenant_attributes")
}

model Session {
  id         String   @id @default(uuid())
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])

  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  user_id    String
  action     String
  entity     String
  entity_id  String
  metadata   Json?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])

  @@map("audit_logs")
}

model Minister {
  id              String            @id @default(uuid())
  name            String
  tenant_id       String?
  icon            String?
  description     String?
  is_active       Boolean           @default(true)
  created_by      String?
  created_at      DateTime          @default(now())
  status          String?
  updated_by      String?
  updated_at      DateTime?
  deleted_by      String?
  deleted_at      DateTime?
  is_deleted      Boolean           @default(false)
  MemberSacrament MemberSacrament[]
  tenant          Tenant?           @relation(fields: [tenant_id], references: [id])

  @@map("ministers")
}

model FamilyIncoming {
  id                 String    @id @default(uuid())
  tenant_id          String?
  family_id          String    @unique
  source_parish_name String?
  source_family_name String?
  migration_date     DateTime?
  created_at         DateTime  @default(now())
  source_prayer_name String?
  source_ward_name   String?
  family             Family    @relation(fields: [family_id], references: [id])
  tenant             Tenant?   @relation(fields: [tenant_id], references: [id])

  @@map("family_incomings")
}

model FamilyEditRequest {
  id              String    @id @default(uuid())
  family_id       String
  previous_data   Json
  pending_changes Json
  status          String    @default("PENDING")
  reason          String?
  created_by      String?
  created_at      DateTime  @default(now())
  updated_by      String?
  updated_at      DateTime?
  family          Family    @relation(fields: [family_id], references: [id])

  @@map("family_edit_requests")
}

model FamilOutgoing {
  id                      String    @id @default(uuid())
  tenant_id               String?
  family_id               String?
  source_parish_name      String?
  source_parish_id        String?
  source_family_name      String?
  source_family_id        String?
  migration_date          DateTime?
  file                    String?
  remarks                 String?
  created_at              DateTime  @default(now())
  destination_family_name String?
  destination_parish_name String?
  destination_prayer_name String?
  destination_ward_name   String?
  source_prayer_id        String?
  source_prayer_name      String?
  source_ward_id          String?
  source_ward_name        String?
  member_id               String?
  family                  Family?   @relation(fields: [family_id], references: [id])
  member                  Member?   @relation(fields: [member_id], references: [id])
  tenant                  Tenant?   @relation(fields: [tenant_id], references: [id])

  @@map("family_outgoings")
}

model FamilTransfer {
  id                 String    @id @default(uuid())
  tenant_id          String?
  family_id          String?
  source_parish_name String?
  source_parish_id   String?
  source_family_name String?
  source_family_id   String?
  migration_date     DateTime?
  file               String?
  remarks            String?
  to_parish_name     String?
  to_parish_id       String?
  to_family_name     String?
  to_family_id       String?
  created_at         DateTime  @default(now())
  source_member_id   String?
  source_member_name String?
  to_member_id       String?
  to_member_name     String?
  family             Family?   @relation(fields: [family_id], references: [id])
  tenant             Tenant?   @relation(fields: [tenant_id], references: [id])

  @@map("family_transfers")
}

model MemberSacrament {
  id                  String                @id @default(uuid())
  member_id           String?
  sacrament_id        String
  date                DateTime?
  church_name         String?
  serial_no           String?
  is_enable           Boolean               @default(false)
  reference_no        String?
  page_no             String?
  file                String?
  notes               String?
  minister_id         String?
  ward_id             String?
  is_bulk_uploaded    Boolean               @default(false)
  member              Member?               @relation(fields: [member_id], references: [id])
  minister            Minister?             @relation(fields: [minister_id], references: [id])
  sacrament           Sacrament             @relation(fields: [sacrament_id], references: [id])
  ward                Ward?                 @relation(fields: [ward_id], references: [id])
  SacramentSubmission SacramentSubmission[]

  @@map("member_sacraments")
}

model Marriage {
  id                String    @id @default(uuid())
  family_id         String?
  husband_id        String?
  wife_id           String?
  marriage_date     DateTime
  created_by        String?
  created_at        DateTime  @default(now())
  status            String?
  updated_by        String?
  updated_at        DateTime?
  deleted_by        String?
  deleted_at        DateTime?
  is_deleted        Boolean   @default(false)
  marriage_no       String?
  husband_family_id String?
  wife_family_id    String?
  husband_name      String?
  wife_name         String?
  divorce           Divorce?
  family            Family?   @relation(fields: [family_id], references: [id])
  husband           Member?   @relation("Husband", fields: [husband_id], references: [id])
