generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  email           String?
  is_active       Boolean          @default(true)
  status          TenantStatus     @default(ACTIVE)
  created_at      DateTime         @default(now())
  address_line1   String?
  address_line2   String?
  city            String?
  country         String?
  diocese_id      String?
  domain          String?
  image           String?
  latitude        Float?
  longitude       Float?
  phone           String?
  postal_code     String?
  state           String?
  notifications   Notification[]
  classifications Classification[]
  contributions   Contribution[]
  families        Family[]
  members         Member[]
  prayer_groups   PrayerGroup[]
  relations       Relation[]
  requests        Request[]
  roles           Role[]
  diocese         Diocese?         @relation(fields: [diocese_id], references: [id])
  users           User[]
  wards           Ward[]
  broadcasts      Broadcast[]
  no_graves       Int?
  created_by      String?
  updated_by      String?
  updated_at      DateTime?
  deleted_by      String?
  deleted_at      DateTime?
  is_deleted      Boolean          @default(false)

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                    String               @id @default(uuid())
  first_name            String
  last_name             String
  email                 String               @unique
  phone                 String?
  password_hash         String
  tenant_id             String?
  is_active             Boolean              @default(true)
  created_at            DateTime             @default(now())
  updated_at            DateTime?
  notifications         Notification[]
  otps                  OTP[]
  password_reset_tokens PasswordResetToken[]
  roles                 UserRole[]
  tenant                Tenant?              @relation(fields: [tenant_id], references: [id])

  mfa_enable  Boolean   @default(false)
  lastLoginAt DateTime?

  created_by String?
  updated_by String?

  deleted_by String?
  deleted_at DateTime?
  is_deleted Boolean   @default(false)

  @@index([tenant_id])
  @@map("users")
}

model UserRole {
  id      String @id @default(uuid())
  user_id String
  role_id String
  role    Role   @relation(fields: [role_id], references: [id])
  user    User   @relation(fields: [user_id], references: [id])

  @@unique([user_id, role_id])
  @@map("user_roles")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  permissions Json?

  created_at DateTime  @default(now())
  created_by String?
  updated_by String?
  updated_at DateTime?
  deleted_by String?
  deleted_at DateTime?
  is_deleted Boolean   @default(false)

  tenant_id String?
  tenant    Tenant? @relation(fields: [tenant_id], references: [id])

  users UserRole[]

  @@index([tenant_id])
  @@map("roles")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  user_id   String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [user_id], references: [id])

  @@map("password_reset_tokens")
}

model Family {
  id                String          @id @default(uuid())
  tenant_id         String?
  serial_no         String
  head_name         String
  name              String
  house_name        String?
  phone             String?
  address_line1     String?
  address_line2     String?
  city              String?
  state             String?
  postal_code       String?
  is_active         Boolean         @default(true)
  created_at        DateTime        @default(now())
  updated_at        DateTime?
  classification_id String?
  prayer_group_id   String?
  ward_id           String?
  contributions     Contribution[]
  classification    Classification? @relation(fields: [classification_id], references: [id])
  prayerGroup       PrayerGroup?    @relation(fields: [prayer_group_id], references: [id])
  tenant            Tenant?         @relation(fields: [tenant_id], references: [id])
  ward              Ward?           @relation(fields: [ward_id], references: [id])
  members           Member[]
  requests          Request[]

  type   FamilyType?
  gender Gender?
  dob    DateTime?

  parish_family_id String?

  house_image  String?
  family_image String?

  village  String?
  taluk    String?
  district String?

  country String?

  comment String?

  latitude  Float?
  longitude Float?

  status String?

  created_by String?
  updated_by String?

  deleted_by String?
  deleted_at DateTime?

  is_deleted Boolean @default(false)

  @@index([tenant_id])
  @@index([ward_id])
  @@index([prayer_group_id])
  @@index([classification_id])
  @@map("familys")
}

enum FamilyType {
  CREATED
  INCOMEING
  INCOMING
  OUTGOING
  TRANSFERED
  INTERNAL_SPLIT
  EXTERNAL_SPLIT
}

model Member {
  id               String         @id @default(uuid())
  tenant_id        String?
  family_id        String
  name             String?
  gender           Gender
  dob              DateTime?
  phone            String?
  profession       String?
  christening_name String?
  is_active        Boolean        @default(true)
  email            String?        @unique
  prayer_group_id  String?
  relation_id      String?
  ward_id          String?
  notifications    Notification[]
  contributions    Contribution[]
  member_otps      MemberOTP[]
  family           Family         @relation(fields: [family_id], references: [id])
  prayerGroup      PrayerGroup?   @relation(fields: [prayer_group_id], references: [id])
  relation         Relation?      @relation(fields: [relation_id], references: [id])
  tenant           Tenant?        @relation(fields: [tenant_id], references: [id])
  ward             Ward?          @relation(fields: [ward_id], references: [id])
  requests         Request[]
  is_deceased      Boolean        @default(false)

  created_by String?
  created_at DateTime @default(now())

  status String?

  updated_by String?
  updated_at DateTime?

  deleted_by String?
  deleted_at DateTime?

  is_deleted Boolean @default(false)

  parish_name       String?
  ward_name         String?
  prayer_group_name String?

  type        String?
  blood_group String?

  education_qualification String?

  nri String?

  display_register String?

  available_home String?

  father_name String?
  mother_name String?
  spouse_name String?

  father_id  String?
  mother_id  String?
  husband_id String?

  is_migration Boolean @default(false)

  @@index([tenant_id])
  @@index([family_id])
  @@index([relation_id])
  @@index([ward_id])
  @@index([prayer_group_id])
  @@map("members")
}

model OTP {
  id         String     @id @default(uuid())
  code       String
  purpose    OTPPurpose
  expires_at DateTime
  verified   Boolean    @default(false)
  user_id    String
  user       User       @relation(fields: [user_id], references: [id])

  @@map("otp")
}

model MemberOTP {
  id         String           @id @default(uuid())
  code       String
  expires_at DateTime
  verified   Boolean          @default(false)
  member_id  String
  created_at DateTime         @default(now())
  purpose    MemberOTPPurpose
  member     Member           @relation(fields: [member_id], references: [id])

  @@map("member_otp")
}

model Request {
  id          String        @id @default(uuid())
  tenant_id   String
  member_id   String
  family_id   String
  type        RequestType
  status      RequestStatus @default(PENDING)
  payload     Json
  notes       String?
  created_at  DateTime      @default(now())
  updated_at  DateTime?
  reviewed_at DateTime?
  reviewed_by String?
  family      Family        @relation(fields: [family_id], references: [id])
  member      Member        @relation(fields: [member_id], references: [id])
  tenant      Tenant        @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([member_id])
  @@map("requests")
}

model Contribution {
  id             String              @id @default(uuid())
  tenant_id      String
  member_id      String
  family_id      String
  receipt_no     String?             @unique
  type           ContributionType
  amount         Decimal             @db.Decimal(10, 2)
  purpose        String
  payment_method PaymentMethod
  privacy        ContributionPrivacy
  status         ContributionStatus  @default(PENDING)
  notes          String?
  verified_at    DateTime?
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt
  family         Family              @relation(fields: [family_id], references: [id])
  member         Member              @relation(fields: [member_id], references: [id])
  tenant         Tenant              @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([member_id])
  @@index([family_id])
  @@index([status])
  @@map("contributions")
}

model Notification {
  id         String           @id @default(uuid())
  tenant_id  String
  user_id    String?
  member_id  String?
  title      String
  message    String
  type       NotificationType
  is_read    Boolean          @default(false)
  metadata   Json?
  created_at DateTime         @default(now())
  member     Member?          @relation(fields: [member_id], references: [id])
  tenant     Tenant           @relation(fields: [tenant_id], references: [id])
  user       User?            @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([user_id])
  @@index([member_id])
}

model Diocese {
  id          String    @id @default(uuid())
  name        String
  description String?
  is_active   Boolean   @default(true)
  created_by  String?
  created_at  DateTime  @default(now())
  status      String?
  updated_by  String?
  updated_at  DateTime?
  deleted_by  String?
  deleted_at  DateTime?
  is_deleted  Boolean   @default(false)
  tenants     Tenant[]

  @@map("diocese")
}

model Ward {
  id           String        @id @default(uuid())
  name         String
  tenant_id    String?
  icon         String?
  description  String?
  is_active    Boolean       @default(true)
  created_by   String?
  created_at   DateTime      @default(now())
  status       String?
  updated_by   String?
  updated_at   DateTime?
  deleted_by   String?
  deleted_at   DateTime?
  is_deleted   Boolean       @default(false)
  families     Family[]
  members      Member[]
  prayerGroups PrayerGroup[]
  tenant       Tenant?       @relation(fields: [tenant_id], references: [id])
  broadcasts   Broadcast[]

  @@index([tenant_id])
  @@map("wards")
}

model PrayerGroup {
  id          String    @id @default(uuid())
  name        String
  tenant_id   String?
  ward_id     String?
  icon        String?
  description String?
  is_active   Boolean   @default(true)
  created_by  String?
  created_at  DateTime  @default(now())
  status      String?
  updated_by  String?
  updated_at  DateTime?
  deleted_by  String?
  deleted_at  DateTime?
  is_deleted  Boolean   @default(false)
  families    Family[]
  members     Member[]
  tenant      Tenant?   @relation(fields: [tenant_id], references: [id])
  ward        Ward?     @relation(fields: [ward_id], references: [id])

  @@index([tenant_id])
  @@index([ward_id])
  @@map("prayer_groups")
}

model Classification {
  id          String    @id @default(uuid())
  name        String
  tenant_id   String?
  icon        String?
  description String?
  is_active   Boolean   @default(true)
  created_by  String?
  created_at  DateTime  @default(now())
  status      String?
  updated_by  String?
  updated_at  DateTime?
  deleted_by  String?
  deleted_at  DateTime?
  is_deleted  Boolean   @default(false)
  tenant      Tenant?   @relation(fields: [tenant_id], references: [id])
  families    Family[]

  @@index([tenant_id])
  @@map("classifications")
}

model Relation {
  id          String    @id @default(uuid())
  name        String
  tenant_id   String?
  icon        String?
  description String?
  order       Int       @default(0)
  is_active   Boolean   @default(true)
  created_by  String?
  created_at  DateTime  @default(now())
  status      String?
  updated_by  String?
  updated_at  DateTime?
  deleted_by  String?
  deleted_at  DateTime?
  is_deleted  Boolean   @default(false)
  members     Member[]
  tenant      Tenant?   @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("relation")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum OTPPurpose {
  LOGIN
  RESET_PASSWORD
  VERIFY_PHONE
  VERIFY_EMAIL
}

enum MemberOTPPurpose {
  LOGIN
  VERIFY_PHONE
  VERIFY_EMAIL
}

enum AnnouncementCategory {
  GENERAL
  EVENT
  PRAYER
  SERVICE
  PERSONAL
}

enum RequestType {
  BAPTISM
  MARRIAGE
  DEATH_REGISTRATION
  CERTIFICATE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ContributionType {
  DONATION
  SUBSCRIPTION
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  UPI
  CARD
  CHEQUE
}

enum ContributionPrivacy {
  PUBLIC
  PRIVATE
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  REQUEST
  CONTRIBUTION
  ANNOUNCEMENT
  SYSTEM
}

enum BroadcastType {
  SMS
  WHATSAPP
  EMAIL
  ANNOUNCEMENT
}

enum BroadcastStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CANCELLED
  SCHEDULED
}

model Broadcast {
  id        String  @id @default(uuid())
  tenant_id String?

  type BroadcastType @default(SMS)

  title   String?
  content String?

  category     AnnouncementCategory?
  is_important Boolean               @default(false)

  date DateTime?
  time String?

  ward_id         String?
  target_audience String?

  scheduled_at DateTime?
  sent_at      DateTime?
  delivery_at  DateTime?

  failed_reason String?

  is_delivery    Boolean @default(false)
  is_immediately Boolean @default(false)

  status BroadcastStatus @default(PUBLISHED)

  created_by String?
  created_at DateTime @default(now())

  updated_by String?
  updated_at DateTime?

  deleted_by String?
  deleted_at DateTime?

  is_deleted Boolean @default(false)

  tenant Tenant? @relation(fields: [tenant_id], references: [id])
  ward   Ward?   @relation(fields: [ward_id], references: [id])

  @@index([tenant_id])
  @@index([type])
  @@index([category])
  @@map("broadcasts")
}
