  status             BookingStatus        @default(PENDING)
  created_by         String?
  created_at         DateTime             @default(now())
  updated_by         String?
  updated_at         DateTime?
  deleted_by         String?
  deleted_at         DateTime?
  is_deleted         Boolean              @default(false)
  time               String?
  category           String?
  family_id          String?
  member_id          String?
  prayer_group_id    String?
  ward_id            String?
  reason             String?
  BookingCertificate BookingCertificate[]
  histories          BookingHistory[]
  event_type         EventType?           @relation(fields: [event_type_id], references: [id])
  family             Family?              @relation(fields: [family_id], references: [id])
  member             Member?              @relation(fields: [member_id], references: [id])
  prayerGroup        PrayerGroup?         @relation(fields: [prayer_group_id], references: [id])
  tenant             Tenant?              @relation(fields: [tenant_id], references: [id])
  venue              Venue?               @relation(fields: [venue_id], references: [id])
  ward               Ward?                @relation(fields: [ward_id], references: [id])

  @@map("bookings")
}

model BookingCertificate {
  id             String          @id @default(uuid())
  booking_id     String
  is_certificate Boolean         @default(false)
  fee_applicable Boolean         @default(false)
  type           String
  amount         String
  receipt_no     String
  created_at     DateTime        @default(now())
  status         SacramentStatus @default(PENDING)
  payment_mode   PaymentMode     @default(CASH)
  booking        Booking         @relation(fields: [booking_id], references: [id])

  @@map("booking_certificates")
}

model BookingHistory {
  id              String            @id @default(uuid())
  booking_id      String
  action          TransactionAction
  remarks         String?
  approved_by     String?
  approved_at     DateTime          @default(now())
  previous_status BookingStatus?
  new_status      BookingStatus?
  booking         Booking           @relation(fields: [booking_id], references: [id])

  @@map("booking_histories")
}

model ApprovalQueue {
  id             String         @id @default(uuid())
  module         String
  reference_id   String
  status         ApprovalStatus @default(PENDING)
  priority       String?
  remarks        String?
  submitted_by   String?
  submitted_at   DateTime       @default(now())
  approved_by    String?
  approved_at    DateTime?
  rejected_by    String?
  rejected_at    DateTime?
  reason         String?
  isActive       Boolean        @default(true)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  tenant_id      String?
  entity_id      String?
  entity_type    String?
  certificate_id String?
  is_downloaded  Boolean        @default(false)
  approved       User?          @relation("Approved", fields: [approved_by], references: [id])
  rejected       User?          @relation("Rejected", fields: [rejected_by], references: [id])

  @@map("approval_queues")
}

model CertificateTemplate {
  id                   String                 @id @default(uuid())
  name                 String
  certificate_type     String
  header_text          String?
  footer_text          String?
  status               TemplateStatus         @default(DRAFT)
  tenant_id            String?
  created_by           String?
  created_at           DateTime               @default(now())
  updated_by           String?
  updated_at           DateTime?
  deleted_by           String?
  deleted_at           DateTime?
  is_deleted           Boolean                @default(false)
  GeneratedCertificate GeneratedCertificate[]
  fields               TemplateField[]
  variants             TemplateVariant[]

  @@map("certificate_templates")
}

model TemplateVariant {
  id                   String                 @id @default(uuid())
  template_id          String
  name                 String
  is_default           Boolean                @default(false)
  background_url       String?
  width                Int?
  height               Int?
  created_at           DateTime               @default(now())
  GeneratedCertificate GeneratedCertificate[]
  template             CertificateTemplate    @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@map("template_variants")
}

model TemplateField {
  id          String              @id @default(uuid())
  template_id String
  label       String
  key         String
  type        String?
  is_required Boolean             @default(false)
  order       Int?
  created_at  DateTime            @default(now())
  template    CertificateTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@map("template_fields")
}

model GeneratedCertificate {
  id          String              @id @default(uuid())
  template_id String
  variant_id  String?
  data        Json
  file_url    String?
  tenant_id   String?
  created_by  String?
  created_at  DateTime            @default(now())
  updated_by  String?
  updated_at  DateTime?
  deleted_by  String?
  deleted_at  DateTime?
  is_deleted  Boolean             @default(false)
  template    CertificateTemplate @relation(fields: [template_id], references: [id])
  variant     TemplateVariant?    @relation(fields: [variant_id], references: [id])

  @@map("generate_certificates")
}

model GraveSlot {
  id                   String                @id @default(uuid())
  grave_id             String
  grave_number         String
  member_id            String?
  status               String?               @default("occupied")
  created_at           DateTime              @default(now())
  updated_at           DateTime?             @updatedAt
  is_deleted           Boolean               @default(false)
  created_by           String?
  updated_by           String?
  deleted_by           String?
  deleted_at           DateTime?
  slot_id              String?
  available_slots      String?
  familyAllotmentGrave FamilyAllotmentGrave? @relation(fields: [available_slots], references: [id])
  grave                Grave                 @relation(fields: [grave_id], references: [id], onDelete: Cascade)
  member               Member?               @relation(fields: [member_id], references: [id])
  tenantAllotmentGrave TenantAllotmentGrave? @relation(fields: [slot_id], references: [id])

  @@map("grave_slots")
}

